NODE_ENV=development
PORT=5000

# MongoDB connection string. Docker Compose runs Mongo as a single-node
# replica set (required for multi-document transactions).
MONGODB_URI=mongodb://mongo:27017/inventory_supply_chain?replicaSet=rs0

# Frontend origin allowed by CORS
FRONTEND_URL=http://localhost:5173

# JWT secrets - generate strong random values for real deployments
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Comma-separated default Super Admin bootstrap (used only by the seed script)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!

# SMTP settings used to send password-reset emails (e.g. Gmail: smtp.gmail.com,
# port 587, secure=false, and an App Password - not your normal Gmail password).
# Leave blank in dev/test - the email service falls back to a no-op transport.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="SupplyChain Pro <no-reply@supplychainpro.local>"

# Base URL of the internal ADK agents service (Docker Compose: http://agents:4000)
AGENTS_SERVICE_URL=http://agents:4000
# Shared secret required by the agents service's POST /run/* routes - must match agents/.env's AGENTS_INTERNAL_API_KEY
AGENTS_INTERNAL_API_KEY=
