NODE_ENV=development
PORT=5000

# MongoDB connection string. Docker Compose runs Mongo as a single-node
# replica set (required for multi-document transactions).
MONGODB_URI=mongodb://mongo:27017/inventory_supply_chain?replicaSet=rs0

# Frontend origin allowed by CORS
FRONTEND_URL=http://localhost:5173

# JWT secrets - generate strong random values for real deployments
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Comma-separated default Super Admin bootstrap (used only by the seed script)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
