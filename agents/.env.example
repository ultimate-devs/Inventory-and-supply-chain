NODE_ENV=development
PORT=4000

# Gemini API key for the ADK agents. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Base URL of the backend Express API (inside Docker Compose, the service is
# reachable as `api` on the compose network; outside Docker, use localhost).
API_BASE_URL=http://api:5000/api/v1

# Service-account credentials created by `npm run seed:agents` in backend/.
# See backend/README.md for the full agent-to-API auth flow.
AGENTS_READONLY_EMAIL=agents-readonly@internal.local
AGENTS_READONLY_PASSWORD=

AGENTS_PROCUREMENT_EMAIL=agents-procurement@internal.local
AGENTS_PROCUREMENT_PASSWORD=

# How often the Monitoring agent runs on its own, in cron syntax.
MONITORING_CRON_SCHEDULE=*/30 * * * *
